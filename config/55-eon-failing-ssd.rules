# 작성: 2026-10-11 18:44:45 +09:00 / 설명 주석 보강: 2026-10-15 22:21:34 +09:00
# 설치 위치: /etc/udev/rules.d/55-eon-failing-ssd.rules
# add/change 이벤트에서 관찰된 문제 SSD 슬롯을 격리해 자동 탐색과 후속 I/O를 억제한다.
# 대상은 block 디스크 중 브리지 1741:1156, SCSI LUN 0, 용량 234441648 섹터의 조합이다.
# /dev/sdX 이름이나 SSD 고유 일련번호 기준이 아니므로 같은 조건의 교체 SSD에도 적용된다.
# ATTRS는 상위 USB 브리지, ATTR{size}와 ATTR{device/state}는 현재 블록 장치 기준이다.
# SCSI 상태를 offline으로 쓰며, 커널이 요구하는 줄바꿈을 e"offline\n"으로 포함한다.
# EON_SSD_QUARANTINED는 격리 표시, UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG는
# 후속 영구 저장장치 규칙의 탐색 생략 요청, UDISKS_IGNORE는 UDisks의 무시 요청이다.
# SSD/슬롯 수리 또는 교체 후 재사용을 점검할 때는 이 규칙을 해제해야 한다.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd*", DEVPATH=="*/host*/target*/*:0:0:0/block/*", ATTRS{idVendor}=="1741", ATTRS{idProduct}=="1156", ATTR{size}=="234441648", ATTR{device/state}=e"offline\n", ENV{EON_SSD_QUARANTINED}="1", ENV{UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG}="1", ENV{UDISKS_IGNORE}="1"
